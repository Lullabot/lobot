# Copy to .env (gitignored) and fill in. Each PM uses their own values.
# GitHub personal access token for the gh CLI in sessions without a gh login (e.g. Cowork).
# Classic token, scopes: repo, project, read:org. Authorize for the org's SSO if prompted. Short expiry.
GH_TOKEN=

# Jira Cloud, for the jira skill's jira.py: the site (yoursite.atlassian.net), your Atlassian login email, and your own
# API token (id.atlassian.com > Security > API tokens > Create API token, without scopes). Short expiry.
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
